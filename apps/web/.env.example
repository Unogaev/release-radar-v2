# Database (Neon/Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/release_radar?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Telegram alerts
TELEGRAM_BOT_TOKEN=""

# One-time owner account creation (scripts/seedOwner.ts) — not runtime vars,
# set them only when running the seed script.
# OWNER_EMAIL="you@example.com"
# OWNER_PASSWORD="choose-a-strong-password"
