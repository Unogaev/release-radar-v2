// packages/db/schema.prisma
//
// Implements spec §15 EXACTLY: 21 core tables, with the constraints called
// out explicitly in "Ключевые ограничения":
//   - market_sales and market_asks are separate tables (never merged)
//   - every price has currency, source, observed_at, and variant
//   - availability check is tied to ZIP/region and seller-of-record
//   - release_event stores start_at_utc, source_timezone, time_precision
//   - evidence is immutable — a new check creates a new row, never updates
//   - decision stores rule_version and explanation
//   - purchase is only created after explicit user confirmation or a
//     confirmed order event
//
// Auth: email + password only (no magic link, no Telegram login) per the
// user's explicit instruction — passwordHash on User, nothing else.

generator client {
  provider = "prisma-client-js"
  output   = "../../apps/web/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================== Core / Users ==============================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  preferences       UserPreferences?
  buyerRequests     BuyerRequest[]
  purchases         Purchase[]
  alerts            Alert[]
  reminderEvents    ReminderEvent[]
  circleMemberships CircleMember[]
  auditLogEntries   AuditLog[]
}

model UserPreferences {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String   @unique
  categories           String[]
  brands               String[]
  shoeSizes            String[]
  apparelSizes         String[]
  budgetMinor          Int?
  budgetCurrency       String   @default("USD")
  zip                  String?
  city                 String?
  purchaseCountries    String[]
  goal                 String   @default("self")
  minProfitMinor       Int?
  minRoi               Float?
  notificationChannels String[]
  quietHoursStart      String?
  quietHoursEnd        String?
  allowedRetailers     String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ============================== Product identity ==============================

model Product {
  id              String   @id @default(cuid())
  brand           String
  normalizedModel String
  category        String
  createdAt       DateTime @default(now())

  variants ProductVariant[]

  @@index([brand, normalizedModel])
}

model ProductVariant {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id])
  productId    String
  variantLabel String
  createdAt    DateTime @default(now())

  identifiers        Identifier[]
  offers             Offer[]
  releaseEvents      ReleaseEvent[]
  availabilityChecks AvailabilityCheck[]
  evidence           Evidence[]
  signals            Signal[]
  decisions          Decision[]
  marketSales        MarketSale[]
  marketAsks         MarketAsk[]
  buyerRequests      BuyerRequest[]
  purchases          Purchase[]
  feedCard           FeedCard?

  @@index([productId, variantLabel])
}

model Identifier {
  id               String         @id @default(cuid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  kind             String
  value            String

  @@index([kind, value])
}

// ============================== Sources / Sellers / Offers ==============================

model Source {
  id           String   @id @default(cuid())
  name         String
  sourceClass  String // "A_truth" | "B_market" | "C_signal" (spec §9)
  url          String
  parseVersion String
  createdAt    DateTime @default(now())

  // ---- Source Registry fields (auto-collection) ----
  category             String    @default("other")
  officialDomain       String?
  sourceType           String    @default("MANUAL") // RSS | API | SITEMAP | NEWSROOM | PRODUCT_LISTING | RELEASE_CALENDAR | BROWSER_VERIFICATION | SOCIAL_DISCOVERY | MARKET_SALES | MANUAL
  trustLevel           Int       @default(3)
  checkIntervalMinutes Int       @default(60)
  adapterStatus        String    @default("active") // "active" | "disabled" | "error"
  lastCheckedAt        DateTime?
  lastSuccessAt        DateTime?
  lastError            String?
  itemsDiscovered      Int       @default(0)
  isEnabled            Boolean   @default(true)

  availabilityChecks AvailabilityCheck[]
  evidence           Evidence[]
  signals            Signal[]
  sourceHealth       SourceHealth[]
}

model Seller {
  id         String   @id @default(cuid())
  name       String   @unique
  isOfficial Boolean  @default(false)
  createdAt  DateTime @default(now())

  offers Offer[]
}

model Offer {
  id               String         @id @default(cuid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  seller           Seller         @relation(fields: [sellerId], references: [id])
  sellerId         String
  sellerSku        String
  region           String
  createdAt        DateTime       @default(now())

  @@unique([productVariantId, sellerId, sellerSku, region])
}

// ============================== Release events / Availability ==============================

model ReleaseEvent {
  id                String         @id @default(cuid())
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId  String
  startAtUtc        DateTime?
  sourceTimezone    String?
  timePrecision     String
  eventStartVersion Int            @default(1)
  createdAt         DateTime       @default(now())

  reminderEvents ReminderEvent[]
}

model AvailabilityCheck {
  id               String         @id @default(cuid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  source           Source         @relation(fields: [sourceId], references: [id])
  sourceId         String

  metadataStatus   String?
  visibleUiStatus  String?
  ctaState         String?
  variantAvailable Boolean?
  shippingState    String
  pickupState      String
  cartState        String
  checkoutState    String
  url              String?
  sellerOfRecord   String?

  zip             String?
  sessionRegion   String?
  evidenceBlobRef String?

  checkedAt DateTime @default(now())
  priceUsd  Float?
  currency  String?

  @@index([productVariantId, checkedAt])
  @@index([zip])
}

// ============================== Evidence (immutable) / Signals ==============================

model Evidence {
  id               String         @id @default(cuid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  source           Source         @relation(fields: [sourceId], references: [id])
  sourceId         String
  url              String?
  level            String
  rawSnapshotRef   String
  parseVersion     String
  observedAt       DateTime       @default(now())

  @@index([productVariantId, observedAt])
}

model Signal {
  id               String          @id @default(cuid())
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productVariantId String?
  source           Source          @relation(fields: [sourceId], references: [id])
  sourceId         String
  rawText          String?
  url              String?
  observedAt       DateTime        @default(now())
}

// ============================== Decisions / Alerts / Reminders ==============================

model Decision {
  id                 String         @id @default(cuid())
  productVariant     ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId   String
  status             String
  ruleVersion        String
  rationale          String
  blockedReasons     String[]
  evidenceConfidence Int
  createdAt          DateTime       @default(now())
  // Wave 2: auditable money trail — line items labeled observed / estimated /
  // user_set, budget basis, resale inputs. Nullable: older rows predate it.
  economicsJson      Json?

  alerts Alert[]

  @@index([productVariantId, createdAt])
}

model Alert {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  decision   Decision  @relation(fields: [decisionId], references: [id])
  decisionId String
  channel    String
  payload    String
  dedupeKey  String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([dedupeKey])
}

model ReminderEvent {
  id                String       @id @default(cuid())
  user              User         @relation(fields: [userId], references: [id])
  userId            String
  releaseEvent      ReleaseEvent @relation(fields: [releaseEventId], references: [id])
  releaseEventId    String
  stage             String
  eventStartVersion Int
  idempotencyKey    String       @unique
  sentAt            DateTime?
  createdAt         DateTime     @default(now())
}

// ============================== Market data (sales vs asks — separate) ==============================

model MarketSale {
  id               String         @id @default(cuid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  platform         String
  priceMinor       Int
  currency         String
  observedAt       DateTime
  createdAt        DateTime       @default(now())

  @@index([productVariantId, observedAt])
}

model MarketAsk {
  id               String         @id @default(cuid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  platform         String
  priceMinor       Int
  currency         String
  observedAt       DateTime
  createdAt        DateTime       @default(now())

  @@index([productVariantId, observedAt])
}

// ============================== Buyer requests / Purchases ==============================

model BuyerRequest {
  id                     String         @id @default(cuid())
  user                   User           @relation(fields: [userId], references: [id])
  userId                 String
  productVariant         ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId       String
  customerCeilingMinor   Int
  currency               String         @default("USD")
  deadline               DateTime?
  destination            String?
  depositState           String         @default("none")
  provenanceRequirements String?
  contactOwner           String?
  legalFlags             String[]
  createdAt              DateTime       @default(now())
}

model Purchase {
  id                String         @id @default(cuid())
  user              User           @relation(fields: [userId], references: [id])
  userId            String
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId  String
  actualCostMinor   Int
  currency          String         @default("USD")
  status            String         @default("confirmed")
  confirmedAt       DateTime       @default(now())
  outcome           String?
  actualProfitMinor Int?
}

// ============================== Circles ==============================

model Circle {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members CircleMember[]
}

model CircleMember {
  id       String @id @default(cuid())
  circle   Circle @relation(fields: [circleId], references: [id])
  circleId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String

  @@unique([circleId, userId])
}

// ============================== Ops ==============================

model SourceHealth {
  id            String    @id @default(cuid())
  source        Source    @relation(fields: [sourceId], references: [id])
  sourceId      String
  status        String
  lastSuccessAt DateTime?
  checkedAt     DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}


// Materialized per-variant card assets. Resolving a product image and checking
// link liveness requires live network calls (page fetch + HEAD, up to 7s
// each) — far too expensive and flaky to run inside the page render path.
// The collector cron builds these rows in the background; /now only reads
// them. Until a row exists, cards degrade gracefully to WATCH via the
// existing honesty gate instead of showing unverified actions.
model FeedCard {
  id               String         @id @default(cuid())
  productVariantId String         @unique
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  imageUrl         String?
  imageSourceUrl   String?
  imageProvenance  String?
  primaryUrl       String?
  linkLive         Boolean        @default(false)
  checkedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([updatedAt])
}

// ============================== Access marketplace (pre-launch) ==============================
// "Radar finds the window, Access walks through it."
//
// The Access marketplace (Uber for scarce goods) is NOT launched yet. It stays
// gated until 4+ weeks of stable radar core and 100+ signals (decision
// 2026-09-29). These two models are laid in advance so the radar side can
// reference them later (e.g. a decision seeding a client request) without
// building the marketplace itself.
//
// NOTE: after this schema change lands, run `prisma db push`
// (from apps/web: `npm run prisma:push`) against the production database to
// create the tables. No application code touches these models yet, so the app
// is unaffected until then.

model ClientRequest {
  id          String   @id @default(cuid())
  // What the client wants acquired.
  title       String
  brand       String?
  model       String?
  identifier  String? // SKU / style code / reference — the strong dedupe key
  maxPriceUsd Float?
  quantity    Int      @default(1)
  // Fulfilment constraints.
  region      String? // e.g. "US-FL"
  zip         String?
  deadlineAt  DateTime?
  notes       String?
  // Who posted it (freeform — the client supplies their own contact).
  clientName    String?
  clientContact String?
  // Lifecycle: open -> matched -> in_progress -> fulfilled | cancelled
  status String @default("open")
  // Loose references back to the radar side (informational until launch).
  decisionId       String?
  productVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks RunnerTask[]

  @@index([status, createdAt])
}

model RunnerTask {
  id              String        @id @default(cuid())
  clientRequest   ClientRequest @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  clientRequestId String
  // Who runs it (freeform — the runner supplies their own contact).
  runnerName    String?
  runnerContact String?
  // Execution: offered -> accepted -> sourcing -> purchased -> delivered | failed | cancelled
  status String @default("offered")
  // Economics snapshotted at acceptance — later price moves don't rewrite history.
  agreedFeeUsd      Float?
  agreedMaxPriceUsd Float?
  receiptUrl        String?
  receiptAmountUsd  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientRequestId, status])
}
